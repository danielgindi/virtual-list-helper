{
  "name": "@danielgindi/virtual-list-helper",
  "version": "1.0.19",
  "description": "A collection of dom utilities. So you can work natively with the dom without dom frameworks.",
  "main": "dist/virtual-list-helper.cjs.min.cjs",
  "module": "lib/index.js",
  "broswer": "dist/virtual-list-helper.umd.min.js",
  "type": "module",
  "author": {
    "name": "Daniel Cohen Gindi",
    "email": "danielgindi@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/danielgindi/virtual-list-helper.git"
  },
  "directories": {
    "dist": "dist",
    "lib": "lib"
  },
  "scripts": {
    "build": "npm run lint && node ./scripts/build.js",
    "lint": "eslint -f codeframe ./",
    "lint-fix": "eslint -f codeframe --fix ./",
    "prepublishOnly": "npm run build",
    "prepare": "husky",
    "build:types": "tsc --emitDeclarationOnly && vue-tsc --emitDeclarationOnly -p tsconfig.vue.json",
    "typecheck": "tsc --emitDeclarationOnly && vue-tsc --noEmit -p tsconfig.vue.json",
    "test": "npm run build && vitest run && npm run test:types",
    "test:browser": "vitest run --project browser",
    "test:package": "npm run build && vitest run --project package",
    "test:types": "npm run build:types && vue-tsc --noEmit -p tests/tsconfig.json && tsc -p tests/types/tsconfig.json",
    "test:watch": "vitest --project browser"
  },
  "bugs": {
    "url": "https://github.com/danielgindi/virtual-list-helper/issues"
  },
  "homepage": "https://github.com/danielgindi/virtual-list-helper#readme",
  "license": "MIT",
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/runtime": "^7.29.7",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-babel": "^7.1.0",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@types/node": "^26.6.4",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vitest/browser-playwright": "^5.0.3",
    "core-js": "^3.50.0",
    "eslint": "^10.12.0",
    "eslint-formatter-codeframe": "^7.32.2",
    "fs-extra": "^11.4.1",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "pinst": "^3.0.0",
    "playwright": "^1.63.0",
    "rollup": "^4.64.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3",
    "vue": "^3.5.43",
    "vue-tsc": "^3.3.12"
  },
  "dependencies": {
    "@danielgindi/dom-utils": "^1.0.11"
  },
  "peerDependencies": {
    "vue": "^3.*"
  },
  "peerDependenciesMeta": {
    "vue": {
      "optional": true
    }
  },
  "types": "lib/index.d.ts"
}

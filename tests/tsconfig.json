{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": "..",
    "types": [
      "node",
      "vitest/importMeta"
    ],
    "declaration": false,
    "declarationMap": false
  },
  "include": [
    "../src/**/*",
    "../vue/**/*.vue",
    "./browser/**/*.ts",
    "./package/**/*.ts",
    "../vitest.config.ts"
  ],
  "exclude": [
    "../node_modules",
    "../dist"
  ]
}
